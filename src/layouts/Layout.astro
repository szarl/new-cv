---
import '../styles/global.css'; // Import global styles (Tailwind)
import { getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import ProfilePhoto from '../assets/developer_me.webp';
import { CONTACT, PROFILES } from '../lib/agent-content';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'Karol Rutkowski - AI Engineer & Software Engineer',
	description = 'Karol Rutkowski is an AI Engineer and Software Engineer from Wrocław, Poland, building LLM-powered applications, backend services and full-stack web apps.',
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://karol-rutkowski.com');
// One canonical form per page: no trailing slash (matches the nav links and the sitemap).
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;

const ogImage = await getImage({ src: ProfilePhoto, width: 1200, height: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, siteUrl).href;

const sameAs = [PROFILES.linkedin, PROFILES.github];
const address = { '@type': 'PostalAddress', addressLocality: CONTACT.locality, addressCountry: CONTACT.country };
const contactPoint = {
	'@type': 'ContactPoint',
	contactType: 'professional inquiries',
	email: CONTACT.email,
	telephone: CONTACT.telephone,
	url: `${siteUrl.origin}/contact`,
};
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${siteUrl.origin}/#organization`,
			name: 'Karol Rutkowski',
			url: `${siteUrl.origin}/`,
			logo: ogImageUrl,
			description: 'AI engineering and software development by Karol Rutkowski, AI Engineer and Software Engineer from Wrocław, Poland.',
			founder: { '@id': `${siteUrl.origin}/#person` },
			email: CONTACT.email,
			telephone: CONTACT.telephone,
			contactPoint,
			address,
			sameAs,
		},
		{
			'@type': 'Person',
			'@id': `${siteUrl.origin}/#person`,
			name: 'Karol Rutkowski',
			url: `${siteUrl.origin}/`,
			image: ogImageUrl,
			jobTitle: 'AI Engineer',
			description,
			worksFor: { '@type': 'Organization', name: 'MasterBorn' },
			email: CONTACT.email,
			telephone: CONTACT.telephone,
			address,
			contactPoint,
			knowsAbout: [
				'Artificial Intelligence',
				'Large Language Models',
				'Machine Learning',
				'Software Engineering',
				'Backend Development',
				'Full Stack Development',
				'TypeScript',
				'Node.js',
				'Python',
				'AWS',
			],
			sameAs,
		},
		{
			'@type': 'WebSite',
			'@id': `${siteUrl.origin}/#website`,
			name: 'Karol Rutkowski',
			url: `${siteUrl.origin}/`,
			inLanguage: 'en',
			publisher: { '@id': `${siteUrl.origin}/#person` },
		},
	],
};

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/experience', label: 'Experience' },
	{ href: '/education', label: 'Education' },
	{ href: '/skills', label: 'Skills' },
	{ href: '/certificates', label: 'Certificates' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contact', label: 'Contact' },
];

// Each page gets its own reveal style, keyed off the first path segment (see global.css).
const section = Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'home';
const isActive = (href: string) => (href === '/' ? section === 'home' : `/${section}` === href);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Karol Rutkowski" />
		{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalUrl} />}
		<meta name="theme-color" content="#082f49" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{canonicalPath === '/' && !noindex && <link rel="alternate" type="text/markdown" href="/index.md" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Karol Rutkowski" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="Karol Rutkowski" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class="bg-slate-50 min-h-screen bg-gradient-to-b from-sky-950 to-black text-slate-100" data-page={section}>
		<div class="aurora" aria-hidden="true">
			<span></span>
			<span></span>
			<span></span>
		</div>
		<div class="scroll-progress" aria-hidden="true"></div>
		<header class="site-header py-5 fixed top-0 left-0 right-0 z-10">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
				<a href="/" class="brand text-xl font-bold text-sky-400">Karol Rutkowski</a>

				<!-- Mobile menu button -->
				<button class="md:hidden p-2" id="menu-button" aria-label="Toggle menu">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>

				<!-- Desktop navigation -->
				<nav class="hidden md:flex space-x-8">
					{
						navLinks.map((link) => (
							<a href={link.href} class="nav-link hover:text-sky-400 transition-colors" aria-current={isActive(link.href) ? 'page' : undefined}>
								{link.label}
							</a>
						))
					}
				</nav>

				<!-- Mobile navigation -->
				<nav
					class="transform transition-all duration-300 ease-in-out absolute top-full left-0 right-0 bg-slate-950/95 backdrop-blur-sm border border-sky-400/10 mt-2 p-4 rounded-lg"
					id="mobile-menu"
					style="opacity: 0; transform: scale(0.95); display: none;"
				>
					<div class="flex flex-col space-y-4">
						{
							navLinks.map((link) => (
								<a href={link.href} class="hover:text-sky-400 transition-colors" aria-current={isActive(link.href) ? 'page' : undefined}>
									{link.label}
								</a>
							))
						}
					</div>
				</nav>
			</div>
		</header>

		<script is:inline>
			const menuButton = document.getElementById('menu-button');
			const mobileMenu = document.getElementById('mobile-menu');
			menuButton.addEventListener('click', () => {
				if (mobileMenu.style.display === 'none') {
					mobileMenu.style.display = 'block';
					setTimeout(() => {
						mobileMenu.style.opacity = '1';
						mobileMenu.style.transform = 'scale(1)';
					}, 10);
				} else {
					mobileMenu.style.opacity = '0';
					mobileMenu.style.transform = 'scale(0.95)';
					setTimeout(() => {
						mobileMenu.style.display = 'none';
					}, 300);
				}
			});
		</script>

		<main class="pt-24 pb-12">
			<slot />
		</main>

		<Footer />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
